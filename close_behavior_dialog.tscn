[gd_scene format=3 uid="uid://bg5m2wc5hmj34"]

[ext_resource type="Script" uid="uid://damanhv2efwuq" path="res://close_behavior_dialog.gd" id="1_close_behavior_dialog"]

[sub_resource type="GDScript" id="GDScript_window_presenter"]
script/source = "extends Node

func _ready() -> void:
	owner.visible = false

func popup_near_mouse() -> void:
	%DontAskAgain.button_pressed = false
	_place_near_global_mouse()
	owner.show()
	owner.grab_focus()

func _place_near_global_mouse() -> void:
	var dialog := owner as Window
	var anchor_global := DisplayServer.mouse_get_position()
	var screen := DisplayServer.get_screen_from_rect(Rect2(anchor_global, Vector2.ONE))
	dialog.current_screen = screen
	dialog.reset_size()
	var window_size: Vector2i = dialog.size
	var usable := DisplayServer.screen_get_usable_rect(screen)
	var pos := anchor_global
	pos.x = clampi(pos.x, usable.position.x, usable.position.x + maxi(0, usable.size.x - window_size.x))
	pos.y = clampi(pos.y, usable.position.y, usable.position.y + maxi(0, usable.size.y - window_size.y))
	dialog.position = pos
"

[sub_resource type="GDScript" id="GDScript_exit_button"]
script/source = "extends Button

func _on_pressed() -> void:
	owner.exit_chosen.emit(%DontAskAgain.button_pressed)
	owner.hide()
"

[sub_resource type="GDScript" id="GDScript_hide_button"]
script/source = "extends Button

func _on_pressed() -> void:
	owner.hide_chosen.emit(%DontAskAgain.button_pressed)
	owner.hide()
"

[sub_resource type="GDScript" id="GDScript_cancel_button"]
script/source = "extends Button

func _on_pressed() -> void:
	owner.hide()
"

