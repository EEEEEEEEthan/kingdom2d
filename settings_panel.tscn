[ext_resource type="Texture2D" uid="uid://d1uypro677rg0" path="res://theme.png" id="1_k4ubr"]

[sub_resource type="AtlasTexture" id="AtlasTexture_us4cm"]
atlas = ExtResource("1_k4ubr")
region = Rect2(5, 5, 6, 6)

[sub_resource type="GDScript" id="GDScript_scale_slider"]
script/source = "extends HSlider

func _ready() -> void:
	set_value_no_signal(float(Settings.display_scale))
	Settings.display_scale_changed.connect(_on_settings_display_scale_changed)

func _on_settings_display_scale_changed(new_scale: int) -> void:
	set_value_no_signal(float(new_scale))

func _on_value_changed(new_value: float) -> void:
	Settings.display_scale = int(new_value)
"

[sub_resource type="GDScript" id="GDScript_width_slider"]
script/source = "extends HSlider

func _ready() -> void:
	var screen_width := DisplayServer.screen_get_size(get_window().current_screen).x
	var max_ratio := minf(1.0, float(4096) / float(screen_width))
	max_value = max_ratio
	if Settings.game_width_ratio > max_ratio:
		Settings.game_width_ratio = max_ratio
	set_value_no_signal(minf(Settings.game_width_ratio, max_value))

func _on_value_changed(new_value: float) -> void:
	Settings.game_width_ratio = new_value
"

[sub_resource type="GDScript" id="GDScript_reset_game"]
script/source = "extends Button

func _on_pressed() -> void:
	%ResetConfirmDialog.popup_centered()
"

[sub_resource type="GDScript" id="GDScript_reset_confirm"]
script/source = "extends ConfirmationDialog

func _ready() -> void:
	visible = false

func _on_confirmed() -> void:
	owner.reset_game_requested.emit()
"

