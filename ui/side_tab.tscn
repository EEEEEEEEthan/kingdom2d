[gd_scene format=3 uid="uid://csidetabbtn001"]

[ext_resource type="Script" path="res://ui/side_tab.gd" id="1_side_tab"]

[sub_resource type="GDScript" id="GDScript_close"]
script/source = "extends TextureButton

func _ready() -> void:
	texture_normal = get_theme_icon(&\"close\", &\"Window\")
	texture_pressed = get_theme_icon(&\"close_pressed\", &\"Window\")
	if texture_pressed == null:
		texture_pressed = texture_normal
	ignore_texture_size = true
	stretch_mode = TextureButton.STRETCH_KEEP_ASPECT_CENTERED
	mouse_filter = Control.MOUSE_FILTER_STOP
	focus_mode = Control.FOCUS_NONE
	action_mode = BaseButton.ACTION_MODE_BUTTON_RELEASE


func _on_pressed() -> void:
	owner.close_pressed.emit()
"

[node name="SideTab" type="Button"]
custom_minimum_size = Vector2(18, 16)
offset_right = 36.0
offset_bottom = 16.0
focus_mode = 0
text = ""
clip_text = true
alignment = 0
script = ExtResource("1_side_tab")

[node name="CloseButton" type="TextureButton" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 0
anchors_preset = 6
anchor_left = 1.0
anchor_top = 0.5
anchor_right = 1.0
anchor_bottom = 0.5
offset_left = -13.0
offset_top = -5.0
offset_right = -3.0
offset_bottom = 5.0
grow_horizontal = 0
grow_vertical = 2
mouse_filter = 0
focus_mode = 0
script = SubResource("GDScript_close")

[connection signal="pressed" from="CloseButton" to="CloseButton" method="_on_pressed"]
