[gd_scene format=3 uid="uid://bh733akrbo5yi"]

[ext_resource type="Script" path="res://browser/browser.gd" id="1_browser"]
[ext_resource type="Script" uid="uid://b8cqfqxwh05hh" path="res://ui/side_tab_container.gd" id="1_cns6c"]

[sub_resource type="GDScript" id="GDScript_pages"]
script/source = "extends Node

const _PAGE_SCENE := preload(\"res://browser/browser_page.tscn\")
const _SETTINGS_SCENE := preload(\"res://settings_panel.tscn\")
const _INSPECTOR_SCENE := preload(\"res://game/inspector_panel.tscn\")

var _settings_page: Control
var _inspector_pages: Dictionary[Character, Control] = {}


func _ready() -> void:
	owner.close_requested.connect(owner.hide)
	%SideTabContainer.child_exiting_tree.connect(_on_page_exiting_tree)


func open_settings() -> void:
	if is_instance_valid(_settings_page):
		_focus_page(_settings_page)
		return
	var panel := _SETTINGS_SCENE.instantiate() as Control
	panel.reset_game_requested.connect(func() -> void: owner.reset_game_requested.emit())
	_settings_page = _add_page(\"设置\", panel)


func open_inspector(character: Character) -> void:
	var existing: Control = _inspector_pages.get(character)
	if is_instance_valid(existing):
		_focus_page(existing)
		return
	var panel := _INSPECTOR_SCENE.instantiate() as InspectorPanel
	var page := _add_page(\"角色 %s\" % character.id, panel)
	_inspector_pages[character] = page
	await panel.inspect_character(character)
	character.tree_exiting.connect(_on_inspected_character_exiting.bind(character), CONNECT_ONE_SHOT)


func _add_page(title: String, content: Control) -> Control:
	var page := _PAGE_SCENE.instantiate() as Control
	page.name = title
	page.set_meta(\"tab_title\", title)
	content.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	page.get_node(\"Content\").add_child(content)
	%SideTabContainer.add_child(page)
	%SideTabContainer.current_tab = %SideTabContainer.get_tab_count() - 1
	_ensure_visible()
	return page


func _focus_page(page: Control) -> void:
	var pages: Array[Control] = %SideTabContainer.get_tab_controls()
	var idx := pages.find(page)
	if idx >= 0:
		%SideTabContainer.current_tab = idx
	_ensure_visible()


func _ensure_visible() -> void:
	if owner.visible:
		owner.grab_focus()
		return
	owner.open_near_mouse()


func _on_inspected_character_exiting(character: Character) -> void:
	var page: Control = _inspector_pages.get(character)
	_inspector_pages.erase(character)
	if is_instance_valid(page):
		page.queue_free()


func _on_page_exiting_tree(page: Node) -> void:
	if page == _settings_page:
		_settings_page = null
	for character in _inspector_pages.keys():
		if _inspector_pages[character] == page:
			_inspector_pages.erase(character)
			break
	_hide_if_empty.call_deferred()


func _hide_if_empty() -> void:
	if %SideTabContainer.get_tab_count() <= 0:
		owner.hide()
"

