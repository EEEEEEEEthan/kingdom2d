[sub_resource type="GDScript" id="GDScript_pages"]
script/source = "extends Node

func _ready() -> void:
	%SideTabContainer.child_exiting_tree.connect(_on_page_exiting_tree)


func add_page(title: String, content: Control) -> Control:
	var existing := _page_of(content)
	if existing:
		_focus_page(existing)
		return existing
	var page := %BrowserPage.create_instance() as Control
	page.name = title
	page.set_meta(\"tab_title\", title)
	if content.get_parent():
		content.get_parent().remove_child(content)
	content.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	page.get_node(\"VBoxContainer/Content\").add_child(content)
	%SideTabContainer.current_tab = %SideTabContainer.get_tab_count() - 1
	_ensure_visible()
	return page


func _page_of(content: Control) -> Control:
	var node: Node = content
	while node:
		if node.get_parent() == %SideTabContainer:
			return node as Control
		node = node.get_parent()
	return null


func _focus_page(page: Control) -> void:
	var pages: Array[Control] = %SideTabContainer.get_tab_controls()
	var idx := pages.find(page)
	if idx >= 0:
		%SideTabContainer.current_tab = idx
	_ensure_visible()


func _ensure_visible() -> void:
	if owner.visible:
		owner.grab_focus()
		return
	owner.open_near_mouse()


func _on_page_exiting_tree(page: Node) -> void:
	if page is InstancePlaceholder:
		return
	if %SideTabContainer.get_tab_count() <= 0:
		owner.hide()
"

[sub_resource type="GDScript" id="GDScript_drag"]
script/source = "extends Node

var _dragging := false
var _drag_mouse_offset := Vector2i.ZERO


func _input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		var mouse_button := event as InputEventMouseButton
		if mouse_button.button_index != MOUSE_BUTTON_LEFT:
			return
		if mouse_button.pressed:
			if not _is_blank_area():
				return
			_dragging = true
			_drag_mouse_offset = DisplayServer.mouse_get_position() - owner.position
		else:
			_dragging = false
	elif event is InputEventMouseMotion and _dragging:
		var mouse := DisplayServer.mouse_get_position()
		owner.position = mouse - _drag_mouse_offset


func _is_blank_area() -> bool:
	var hovered: Control = owner.get_viewport().gui_get_hovered_control()
	if hovered == null:
		return true
	var node: Node = hovered
	while node and node != owner:
		if node is BaseButton or node is Range or node is SideTabStrip:
			return false
		node = node.get_parent()
	return true
"

