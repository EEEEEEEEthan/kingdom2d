[sub_resource type="GDScript" id="GDScript_pin_logic"]
script/source = "extends Node

var _show_progress := 0.0
var _pin_progress := 0.0
var _leave_grace := 0.0
var _started := false

func setup(hover_source: Control, hover_link: String, content: Control) -> void:
	owner.source = hover_source
	owner.link = hover_link
	%ContentHost.add_child(content)
	%Panel.mouse_entered.connect(func() -> void: owner.hovered = true)
	%Panel.mouse_exited.connect(func() -> void: owner.hovered = false)
	owner.visible = true
	await owner.get_tree().process_frame
	_fit_to_content()
	_place_near_mouse()

func _process(delta: float) -> void:
	var source_hovered := (
			is_instance_valid(owner.source)
			and HoverInfoDispatcher.is_current(owner.source, owner.link)
	)
	if not owner.pinned:
		if source_hovered:
			_show_progress = minf(1.0, _show_progress + delta * 5.0)
			_pin_progress = minf(1.0, _pin_progress + delta * 0.7)
			_started = true
			if _pin_progress >= 1.0:
				owner.pinned = true
				var box := StyleBoxFlat.new()
				box.bg_color = Color(0.8509804, 0.627451, 0.4, 1)
				%Panel.add_theme_stylebox_override(\"panel\", box)
		else:
			_show_progress = maxf(0.0, _show_progress - delta * 5.0)
	else:
		if owner.hovered or source_hovered:
			_leave_grace = 0.0
			_show_progress = minf(1.0, _show_progress + delta * 5.0)
		else:
			_leave_grace += delta
			if _leave_grace > 0.25:
				_show_progress = maxf(0.0, _show_progress - delta * 5.0)
	%Panel.modulate = Color(1, 1, 1, _show_progress)
	if _started and _show_progress <= 0.0:
		owner.queue_free()

func _fit_to_content() -> void:
	var min_size: Vector2 = %Panel.get_combined_minimum_size()
	var scale: float = owner.content_scale_factor
	owner.size = Vector2i(
			maxi(8, ceili(min_size.x * scale)),
			maxi(8, ceili(min_size.y * scale))
	)

func _place_near_mouse() -> void:
	var mouse := DisplayServer.mouse_get_position()
	var win_size: Vector2i = owner.size
	var screen := DisplayServer.get_screen_from_rect(Rect2(mouse, Vector2.ONE))
	var usable := DisplayServer.screen_get_usable_rect(screen)
	var pos := Vector2i(mouse.x + 16, mouse.y - win_size.y / 2)
	if pos.x + win_size.x > usable.position.x + usable.size.x:
		pos.x = mouse.x - win_size.x - 16
	if pos.y + win_size.y > usable.position.y + usable.size.y:
		pos.y = usable.position.y + usable.size.y - win_size.y
	if pos.y < usable.position.y:
		pos.y = usable.position.y
	if pos.x < usable.position.x:
		pos.x = usable.position.x
	owner.current_screen = screen
	owner.position = pos
"

