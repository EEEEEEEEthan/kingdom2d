[gd_scene format=3 uid="uid://binvpanel00001"]

[ext_resource type="Script" path="res://game/characters/inventory_panel.gd" id="1_inventory_panel"]

[sub_resource type="GDScript" id="GDScript_inventory_label"]
script/source = "extends Label

func refresh_item_counts(inventory: Inventory) -> void:
	var lines: PackedStringArray = []
	for item_id in inventory.item_counts:
		var item_count: int = inventory.item_counts[item_id]
		if item_count <= 0:
			continue
		lines.append(\"%s × %s\" % [
				ItemTypeId.get_display_name(item_id as ItemTypeId.TypeId),
				item_count,
		])
	text = \"\\n\".join(lines) if not lines.is_empty() else \"空\"

"

