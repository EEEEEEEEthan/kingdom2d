[gd_scene format=3 uid="uid://binvpanel00001"]

[ext_resource type="Script" path="res://game/characters/inventory_panel.gd" id="1_inventory_panel"]

[sub_resource type="GDScript" id="GDScript_inventory_label"]
script/source = "extends Label

func refresh_item_counts(inventory: Inventory) -> void:
	text = \"%s × %s\" % [
			ItemTypeId.get_display_name(ItemTypeId.TypeId.IRON_COIN),
			inventory.get_item_count(ItemTypeId.TypeId.IRON_COIN),
	]
"

[node name="InventoryPanel" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_inventory_panel")

[node name="InventoryLabel" type="Label" parent="."]
unique_name_in_owner = true
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_top = 7.0
offset_right = -8.0
offset_bottom = -7.0
grow_horizontal = 2
grow_vertical = 2
text = "铁币 × 0"
script = SubResource("GDScript_inventory_label")
