[sub_resource type="GDScript" id="GDScript_inventory_label"]
script/source = "extends Label

func refresh_item_counts(inventory: Inventory) -> void:
	text = \"%s × %s\" % [
			ItemTypeId.get_display_name(ItemTypeId.TypeId.IRON_COIN),
			inventory.get_item_count(ItemTypeId.TypeId.IRON_COIN),
	]
"

