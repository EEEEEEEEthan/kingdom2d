[sub_resource type="GDScript" id="GDScript_ai_brain"]
script/source = "extends Node

const _KEY_BEHAVIOR_TOKEN = 2
const _KEY_BEHAVIOR_TYPE = 3

var ai_task_stack := CharacterAiTaskStack.new()
var _ai_context: CharacterAiContext
var _behavior_token := 0
var _behavior_type: CharacterAiBehaviorTypeId.TypeId = CharacterAiBehaviorTypeId.TypeId.NONE
var _behavior: CharacterAiBehavior = CharacterAiBehavior.new()

func _ready() -> void:
	set_process(true)

func _process(delta_seconds: float) -> void:
	var context := _get_ai_context()
	var desired_type := _desired_behavior_type(context)
	if _behavior_type != desired_type:
		interrupt()
		_behavior_type = desired_type
		_behavior = CharacterAiBehavior.create(desired_type)
	ai_task_stack.tick(delta_seconds, context)
	if ai_task_stack.is_empty():
		_behavior.schedule(context)

func push_ai_task(task: CharacterAiTask) -> void:
	ai_task_stack.push(task, _get_ai_context())

func interrupt() -> void:
	_behavior_token += 1
	ai_task_stack.abandon(_get_ai_context())

func get_behavior_token() -> int:
	return _behavior_token

func deserialize(ai_data: Dictionary) -> void:
	_behavior_token = ai_data.get(_KEY_BEHAVIOR_TOKEN, 0)
	_behavior_type = ai_data.get(_KEY_BEHAVIOR_TYPE, CharacterAiBehaviorTypeId.TypeId.NONE) as CharacterAiBehaviorTypeId.TypeId
	ai_task_stack.deserialize(ai_data, _get_ai_context())
	if _behavior_type == CharacterAiBehaviorTypeId.TypeId.NONE:
		_behavior_type = _infer_behavior_type()
	_behavior = CharacterAiBehavior.create(_behavior_type)

func serialize() -> Dictionary:
	var data := ai_task_stack.serialize()
	data[_KEY_BEHAVIOR_TOKEN] = _behavior_token
	data[_KEY_BEHAVIOR_TYPE] = _behavior_type
	return data

func get_behavior_text() -> String:
	if ai_task_stack.is_empty():
		return \"无\"
	var top_task := ai_task_stack.peek()
	match top_task.get_type_id():
		CharacterAiTaskTypeId.TypeId.MOVE_TO_WORLD_X:
			return \"前往工作点\" if _behavior_type == CharacterAiBehaviorTypeId.TypeId.HARVEST_WORK else \"闲逛\"
		CharacterAiTaskTypeId.TypeId.WAIT_DURATION:
			return \"寻找工作目标\" if _behavior_type == CharacterAiBehaviorTypeId.TypeId.HARVEST_WORK else \"歇息\"
		CharacterAiTaskTypeId.TypeId.HARVEST_STRUCTURE:
			match owner.occupation:
				OccupationId.TypeId.LUMBERJACK:
					return \"砍树\"
				OccupationId.TypeId.SCAVENGER:
					return \"采集灌木\"
				_:
					return \"工作\"
		_:
			return \"未知\"

func get_work_progress_ratio() -> float:
	for task in ai_task_stack.get_tasks():
		if task.get_type_id() == CharacterAiTaskTypeId.TypeId.HARVEST_STRUCTURE:
			return task.get_progress_ratio()
	return -1.0

func _get_ai_context() -> CharacterAiContext:
	if not _ai_context:
		_ai_context = CharacterAiContext.new(owner)
	return _ai_context

func _desired_behavior_type(context: CharacterAiContext) -> CharacterAiBehaviorTypeId.TypeId:
	if context.day_time_period != GameTime.DayTimePeriod.WORK:
		return CharacterAiBehaviorTypeId.TypeId.IDLE_WANDER
	match owner.occupation:
		OccupationId.TypeId.LUMBERJACK, OccupationId.TypeId.SCAVENGER:
			return CharacterAiBehaviorTypeId.TypeId.HARVEST_WORK
		_:
			return CharacterAiBehaviorTypeId.TypeId.IDLE_WANDER

func _infer_behavior_type() -> CharacterAiBehaviorTypeId.TypeId:
	for task in ai_task_stack.get_tasks():
		if task.get_type_id() == CharacterAiTaskTypeId.TypeId.HARVEST_STRUCTURE:
			return CharacterAiBehaviorTypeId.TypeId.HARVEST_WORK
	return CharacterAiBehaviorTypeId.TypeId.IDLE_WANDER
"

