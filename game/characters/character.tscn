[sub_resource type="GDScript" id="GDScript_85w1m"]
script/source = "@tool
extends Sprite2D

@export var _outline_material: Material

@export var outline: Color:
	set(value):
		outline = value
		if not is_node_ready():
			await ready
		material = _outline_material if outline.a > 0 else null
"

[sub_resource type="GDScript" id="GDScript_hover"]
script/source = "extends Area2D

var _is_hovered := false

func _mouse_enter() -> void:
	_is_hovered = true
	owner.outline = Color.WHITE

func _mouse_exit() -> void:
	_is_hovered = false
	owner.outline = Color.TRANSPARENT

func _input(event: InputEvent) -> void:
	if not _is_hovered:
		return
	if not event is InputEventMouseButton:
		return
	var mouse_button := event as InputEventMouseButton
	if mouse_button.button_index != MOUSE_BUTTON_LEFT or not mouse_button.pressed:
		return
	owner.inventory_open_requested.emit()
	get_viewport().set_input_as_handled()
"

