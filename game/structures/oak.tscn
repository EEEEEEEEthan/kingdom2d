[sub_resource type="GDScript" id="GDScript_l17i3"]
script/source = "extends Sprite2D

@export var noise: Noise

func update_texture() -> void:
	var random = noise.get_noise_1d(global_position.x)
	var index = clamp(floor(remap(random, 0, 1, 0, 4)), 0, 3)
	%Sprite2D.region_rect = Rect2i(1 + 16 * index, 1, 14, 15)
"

