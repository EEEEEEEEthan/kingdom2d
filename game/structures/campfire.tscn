[sub_resource type="GDScript" id="GDScript_s7fkd"]
script/source = "extends Sprite2D

var _timeout: float

func _process(delta: float) -> void:
	_timeout -= delta
	if _timeout <= 0:
		frame = (frame + 1) % self.hframes
		_timeout = 0.2
"

