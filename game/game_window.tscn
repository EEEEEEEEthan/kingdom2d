[sub_resource type="GDScript" id="GDScript_viewport_container"]
script/source = "extends SubViewportContainer

const DISSOLVE_DURATION := 0.35

var _progress := 0.0
var _target_progress := 0.0

func _ready() -> void:
	_progress = 0.0
	_target_progress = 0.0
	_apply_progress()
	set_process(false)

func apply_visible_transition(vis: bool) -> void:
	var target := 1.0 if vis else 0.0
	_target_progress = target
	if is_equal_approx(_progress, target):
		return
	set_process(true)
	while not is_equal_approx(_progress, _target_progress):
		await get_tree().process_frame
	if not is_equal_approx(_target_progress, target):
		return

func _process(delta: float) -> void:
	var step := delta / DISSOLVE_DURATION
	if _progress < _target_progress:
		_progress = minf(_progress + step, _target_progress)
	elif _progress > _target_progress:
		_progress = maxf(_progress - step, _target_progress)
	_apply_progress()
	if is_equal_approx(_progress, _target_progress):
		set_process(false)

func _apply_progress() -> void:
	(material as ShaderMaterial).set_shader_parameter(\"progress\", _progress)
"

