[gd_scene format=3 uid="uid://c6xxc447w21ld"]

[ext_resource type="PackedScene" uid="uid://dpvh6vuxwydj5" path="res://game/game.tscn" id="1_le0pw"]

[sub_resource type="GDScript" id="GDScript_le0pw"]
script/source = "extends Window

const BASE_HEIGHT := 64
const MAX_WIDTH := 4096

var _dragging := false
var _drag_mouse_offset := Vector2i.ZERO

@export var scale: int = 1:
	set(value):
		scale = value
		apply_layout()

@export var width_ratio: float = 1.0:
	set(value):
		width_ratio = value
		apply_layout()

func _ready() -> void:
	apply_layout(true)

func apply_layout(align_to_bottom: bool = false) -> void:
	var screen_size := DisplayServer.screen_get_size(current_screen)
	var width := mini(maxi(1, int(round(screen_size.x * width_ratio))), MAX_WIDTH)
	var height := BASE_HEIGHT * scale
	content_scale_factor = float(scale)
	var new_size := Vector2i(width, height)
	if align_to_bottom:
		var screen := current_screen
		var screen_pos := DisplayServer.screen_get_position(screen)
		var usable := DisplayServer.screen_get_usable_rect(screen)
		position = Vector2i(
			screen_pos.x,
			usable.position.y + usable.size.y - height,
		)
		size = new_size
	else:
		var bottom_center := Vector2(position.x + size.x / 2.0, position.y + size.y)
		position = Vector2(bottom_center.x - new_size.x / 2.0, bottom_center.y - new_size.y)
		size = new_size

func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		var mouse_button := event as InputEventMouseButton
		if mouse_button.button_index != MOUSE_BUTTON_RIGHT:
			return
		if mouse_button.pressed:
			_dragging = true
			_drag_mouse_offset = DisplayServer.mouse_get_position() - position
		else:
			_dragging = false
	elif event is InputEventMouseMotion and _dragging:
		position = DisplayServer.mouse_get_position() - _drag_mouse_offset

func _on_settings_display_scale_changed(new_scale: int) -> void:
	scale = new_scale

func _on_settings_game_width_ratio_changed(new_ratio: float) -> void:
	width_ratio = new_ratio

func _on_settings_game_window_visible_changed(is_visible: bool) -> void:
	visible = is_visible

func _on_control_window_reset_game_requested() -> void:
	%Game.reset_game()
"

