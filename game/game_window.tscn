[sub_resource type="GDScript" id="GDScript_le0pw"]
script/source = "extends Window

signal control_window_open_requested

const BASE_HEIGHT := 64
const MAX_WIDTH := 4096

var suppress_dock_position_in_layout := false
var _dragging := false
var _drag_mouse_offset := Vector2i.ZERO

@export var scale: int = 1:
	set(value):
		scale = value
		apply_layout()

@export var width_ratio: float = 1.0:
	set(value):
		width_ratio = value
		apply_layout()

func _ready() -> void:
	apply_layout(true)
	visible = true

func compute_docked_global_position() -> Vector2i:
	var screen := current_screen
	var screen_pos := DisplayServer.screen_get_position(screen)
	var usable := DisplayServer.screen_get_usable_rect(screen)
	var height := BASE_HEIGHT * scale
	return Vector2i(
		screen_pos.x,
		usable.position.y + usable.size.y - height,
	)


func compute_hidden_below_global_position() -> Vector2i:
	var docked_global_position := compute_docked_global_position()
	var screen := current_screen
	var screen_pos := DisplayServer.screen_get_position(screen)
	var screen_size := DisplayServer.screen_get_size(screen)
	return Vector2i(
		docked_global_position.x,
		screen_pos.y + screen_size.y,
	)


func apply_layout(align_to_bottom: bool = false) -> void:
	var screen_size := DisplayServer.screen_get_size(current_screen)
	var width := mini(maxi(1, int(round(screen_size.x * width_ratio))), MAX_WIDTH)
	var height := BASE_HEIGHT * scale
	content_scale_factor = 1.0
	%ViewportContainer.stretch_shrink = scale
	var hud_scale := clampi(scale, 1, 2)
	var new_size := Vector2i(width, height)
	if suppress_dock_position_in_layout:
		size = new_size
		_apply_hud_scale(hud_scale)
		return
	if align_to_bottom:
		position = compute_docked_global_position()
		size = new_size
	else:
		var bottom_center := Vector2(position.x + size.x / 2.0, position.y + size.y)
		position = Vector2(bottom_center.x - new_size.x / 2.0, bottom_center.y - new_size.y)
		size = new_size
	_apply_hud_scale(hud_scale)


func _apply_hud_scale(hud_scale: int) -> void:
	var vbox: VBoxContainer = %GameHud.get_node(^\"%VBoxContainer\")
	var s := float(hud_scale)
	vbox.scale = Vector2.ONE
	vbox.pivot_offset = Vector2(0, vbox.get_combined_minimum_size().y)
	vbox.scale = Vector2(s, s)


func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		var mouse_button := event as InputEventMouseButton
		if mouse_button.button_index != MOUSE_BUTTON_RIGHT:
			return
		if mouse_button.pressed:
			_dragging = true
			_drag_mouse_offset = DisplayServer.mouse_get_position() - position
		else:
			_dragging = false
	elif event is InputEventMouseMotion and _dragging:
		var mouse := DisplayServer.mouse_get_position()
		position = Vector2i(mouse.x - _drag_mouse_offset.x, position.y)

func _on_settings_display_scale_changed(new_scale: int) -> void:
	scale = new_scale

func _on_settings_game_width_ratio_changed(new_ratio: float) -> void:
	width_ratio = new_ratio

func _on_control_window_reset_game_requested() -> void:
	%Game.reset_game()


func _on_game_hud_control_window_open_requested() -> void:
	control_window_open_requested.emit()
"

[sub_resource type="GDScript" id="GDScript_slide"]
script/source = "extends Node

var active := true:
	set(value):
		active = value
		_game_window.suppress_dock_position_in_layout = not active
		_slide_pos_y_velocity = 0.0
		_sync_slide_targets()

var _slide_pos_y: float
var _slide_target_y: float = 0.0
var _slide_y_docked: float
var _slide_y_hidden: float
var _slide_pos_y_velocity: float = 0.0

const SLIDE_SMOOTH_TIME := 0.2

@onready var _game: Game = %Game

var _game_window: Window:
	get:
		if not _game_window:
			_game_window = owner as Window
		return _game_window


func _ready() -> void:
	if not _game_window.is_node_ready():
		await _game_window.ready
	_slide_pos_y = float(_game_window.compute_hidden_below_global_position().y)
	var pos := _game_window.position
	_game_window.position = Vector2i(pos.x, int(_slide_pos_y))
	_sync_slide_targets()
	await get_tree().process_frame
	active = true


func _on_game_window_size_changed() -> void:
	_sync_slide_targets()


func _sync_slide_targets() -> void:
	_slide_pos_y = float(_game_window.position.y)
	_slide_y_docked = float(_game_window.compute_docked_global_position().y)
	_slide_y_hidden = float(_game_window.compute_hidden_below_global_position().y)
	if active:
		_slide_target_y = _slide_y_docked
	else:
		_slide_target_y = _slide_y_hidden


func _process(delta: float) -> void:
	var current: float = _slide_pos_y
	var target: float = _slide_target_y
	var omega: float = 2.0 / maxf(0.0001, SLIDE_SMOOTH_TIME)
	var x: float = omega * delta
	var e: float = 1.0 / (1.0 + x + 0.48 * x * x + 0.235 * x * x * x)
	var change: float = current - target
	var temp: float = (_slide_pos_y_velocity + omega * change) * delta
	_slide_pos_y_velocity = (_slide_pos_y_velocity - omega * temp) * e
	_slide_pos_y = target + (change + temp) * e
	if (target - current) * (_slide_pos_y - target) > 0.0:
		_slide_pos_y = target
		_slide_pos_y_velocity = 0.0
	var pos := _game_window.position
	_game_window.position = Vector2i(pos.x, int(_slide_pos_y))
	var progress := inverse_lerp(_slide_y_docked, _slide_y_hidden, _slide_pos_y)
	_game.view_height = 1.0 - clampf(progress, 0.0, 1.0)
"

[sub_resource type="GDScript" id="GDScript_auto_hide"]
script/source = "extends Node

const SHOW_TRIGGER_ABOVE_PX := 5

var _auto_hide := true
var _manual_active := true
var _auto_hide_delay_seconds := 2.0
var _outside_safe_timer := 0.0

var _slide_controller:
	get:
		if not _slide_controller:
			_slide_controller = %GameWindowSlideController
		return _slide_controller

var _game_window: Window:
	get:
		if not _game_window:
			_game_window = owner as Window
		return _game_window


func _ready() -> void:
	await get_tree().process_frame
	force_show(5)


func force_show(seconds: float) -> void:
	_outside_safe_timer = -seconds
	_slide_controller.active = true


func configure_visibility_control(auto_hide: bool, game_shown: bool) -> void:
	_auto_hide = auto_hide
	_manual_active = game_shown
	_outside_safe_timer = 0.0
	_apply_visibility_policy()


func configure_auto_hide(auto_hide: bool) -> void:
	_auto_hide = auto_hide
	_outside_safe_timer = 0.0
	_apply_visibility_policy()


func configure_auto_hide_delay(seconds: float) -> void:
	_auto_hide_delay_seconds = seconds
	_outside_safe_timer = 0.0


func _apply_visibility_policy() -> void:
	set_process(_auto_hide)
	if not _auto_hide:
		_slide_controller.active = _manual_active


func _process(delta: float) -> void:
	var mouse := DisplayServer.mouse_get_position()
	if _slide_controller.active:
		if _is_mouse_in_safe_zone(mouse):
			_outside_safe_timer = 0.0
		else:
			_outside_safe_timer += delta
			if _outside_safe_timer >= _auto_hide_delay_seconds:
				_slide_controller.active = false
	else:
		if _is_mouse_in_show_trigger(mouse):
			_slide_controller.active = true
		else:
			_outside_safe_timer = 0.0


func _is_mouse_in_safe_zone(mouse: Vector2i) -> bool:
	var window_position := _game_window.position
	var window_size := _game_window.size
	var screen_bottom := _screen_bottom_global_y()
	if window_position.y >= screen_bottom:
		return false
	var zone := Rect2i(window_position.x, window_position.y, window_size.x, screen_bottom - window_position.y)
	return zone.has_point(mouse)


func _screen_bottom_global_y() -> int:
	var screen := _game_window.current_screen
	var screen_origin := DisplayServer.screen_get_position(screen)
	return screen_origin.y + DisplayServer.screen_get_size(screen).y


func _is_mouse_in_show_trigger(mouse: Vector2i) -> bool:
	var docked: Vector2i = _game_window.compute_docked_global_position()
	var window_size := _game_window.size
	var screen_bottom := _screen_bottom_global_y()
	var zone := Rect2i(
		docked.x,
		screen_bottom - SHOW_TRIGGER_ABOVE_PX,
		window_size.x,
		SHOW_TRIGGER_ABOVE_PX,
	)
	return zone.has_point(mouse)
"

[sub_resource type="GDScript" id="GDScript_display_scale_wheel"]
script/source = "extends Node

const MIN_DISPLAY_SCALE := 1
const MAX_DISPLAY_SCALE := 8
const HOOK_NODE_NAME := \"DisplayScaleWheelHook\"

@export var settings: Settings

var _game_window: Window:
	get:
		return owner as Window


func _ready() -> void:
	await get_tree().process_frame
	_register_window_hooks(_game_window.get_parent())


func _register_window_hooks(node: Node) -> void:
	for child in node.get_children():
		if child is Window and child != _game_window:
			_attach_hook(child as Window)
		_register_window_hooks(child)


func _attach_hook(window: Window) -> void:
	if window.get_node_or_null(HOOK_NODE_NAME):
		return
	var hook := WheelHook.new()
	hook.name = HOOK_NODE_NAME
	hook.controller = self
	window.add_child(hook)


func _input(event: InputEvent) -> void:
	_try_apply_display_scale_wheel(event)


func _try_apply_display_scale_wheel(event: InputEvent) -> void:
	if not event is InputEventMouseButton:
		return
	var mouse_button := event as InputEventMouseButton
	if not mouse_button.ctrl_pressed:
		return
	if mouse_button.button_index != MOUSE_BUTTON_WHEEL_UP and mouse_button.button_index != MOUSE_BUTTON_WHEEL_DOWN:
		return
	if not mouse_button.pressed:
		return
	var delta := 1 if mouse_button.button_index == MOUSE_BUTTON_WHEEL_UP else -1
	var new_scale := clampi(settings.display_scale + delta, MIN_DISPLAY_SCALE, MAX_DISPLAY_SCALE)
	if new_scale == settings.display_scale:
		return
	settings.display_scale = new_scale
	get_viewport().set_input_as_handled()


class WheelHook extends Node:
	var controller: Node

	func _input(event: InputEvent) -> void:
		controller._try_apply_display_scale_wheel(event)
"

