[sub_resource type="GDScript" id="GDScript_mdi0g"]
script/source = "extends Label

var game: Game:
	get: return owner.game

func _process(_delta: float) -> void:
	var time = game.game_time
	var year_text = \"\" if time.year <= 1 else \"Year %s \" % time.year
	var season_text : StringName
	match time.month:
		1: season_text = &\"Late Winter\"
		2: season_text = &\"Early Spring\"
		3: season_text = &\"Mid Spring\"
		4: season_text = &\"Late Spring\"
		5: season_text = &\"Early Summer\"
		6: season_text = &\"Mid Summer\"
		7: season_text = &\"Late Summer\"
		8: season_text = &\"Early Autumn\"
		9: season_text = &\"Mid Autumn\"
		10: season_text = &\"Late Autumn\"
		11: season_text = &\"Early Winter\"
		12: season_text = &\"Mid Winter\"
	text = \"%s%s\" % [year_text,season_text]
"

[sub_resource type="GDScript" id="GDScript_popup_menu"]
script/source = "extends PopupMenu

enum ItemId { SETTINGS, QUIT }

const MENU_CONTENT_SCALE := 2.0

func _ready() -> void:
	for structure_config in StructureConfig.configs_by_id.values():
		%BuildSubmenu.add_item(structure_config.name, structure_config.id)
	_apply_menu_content_scale()
	add_submenu_item(\"建造\", %BuildSubmenu.name)
	add_separator()
	add_item(\"退出\", ItemId.QUIT)
	visible = false


func apply_menu_content_scale() -> void:
	_apply_menu_content_scale()


func _apply_menu_content_scale() -> void:
	_apply_window_content_scale(self)
	_apply_window_content_scale(%BuildSubmenu)


func _apply_window_content_scale(menu: Window) -> void:
	menu.content_scale_mode = Window.CONTENT_SCALE_MODE_CANVAS_ITEMS
	menu.content_scale_stretch = Window.CONTENT_SCALE_STRETCH_FRACTIONAL
	menu.content_scale_factor = MENU_CONTENT_SCALE


func _on_build_menu_about_to_popup() -> void:
	_apply_window_content_scale(%BuildSubmenu)


func _on_menu_pressed() -> void:
	_apply_menu_content_scale()
	var global_mouse := DisplayServer.mouse_get_position()
	var screen := DisplayServer.get_screen_from_rect(Rect2(global_mouse, Vector2.ONE))
	current_screen = screen
	var host_window := owner.get_viewport().get_window()
	var local_mouse := global_mouse - host_window.position
	popup_on_parent(Rect2i(Vector2i(local_mouse), Vector2i.ZERO))
	call_deferred(\"_apply_menu_content_scale\")


func _on_id_pressed(id: int) -> void:
	match id as ItemId:
		ItemId.SETTINGS:
			owner.control_window_open_requested.emit()
		ItemId.QUIT:
			owner.quit_requested.emit()


func _on_build_id_pressed(id: int) -> void:
	var structure_config: StructureConfig = StructureConfig.configs_by_id[id as StructureConfig.TypeId]
	owner.game.start_build_placement(structure_config)
"

