[sub_resource type="GDScript" id="GDScript_popup_menu"]
script/source = "extends PopupMenu

enum ItemId { SETTINGS, QUIT }

var _control_window: Window
var _control_window_positioned := false
var _build_menu: PopupMenu


func _ready() -> void:
	_build_menu = PopupMenu.new()
	_build_menu.name = &\"BuildSubmenu\"
	for structure_config in StructureConfig.configs_by_id.values():
		_build_menu.add_item(structure_config.name, structure_config.id)
	_build_menu.id_pressed.connect(_on_build_id_pressed)
	add_child(_build_menu)
	add_submenu_item(\"建造\", _build_menu.name)
	add_separator()
	add_item(\"退出\", ItemId.QUIT)
	visible = false


func _on_menu_pressed() -> void:
	var menu := %Menu
	var global_pos: Vector2i = menu.get_screen_position()
	var screen := DisplayServer.get_screen_from_rect(Rect2(global_pos, Vector2.ONE))
	var screen_pos: Vector2i = global_pos - DisplayServer.screen_get_position(screen) + Vector2i(64, 0)
	current_screen = screen
	popup(Rect2i(screen_pos, Vector2i.ZERO))


func _on_id_pressed(id: int) -> void:
	match id as ItemId:
		ItemId.SETTINGS:
			_show_control_window(DisplayServer.mouse_get_position())
		ItemId.QUIT:
			get_tree().current_scene.request_quit()


func _on_build_id_pressed(id: int) -> void:
	_start_build_placement(StructureConfig.configs_by_id[id as StructureConfig.TypeId])


func _start_build_placement(structure_config: StructureConfig) -> void:
	var game := _get_game()
	game.horizon.add_child(load(\"res://game/build/structure_build_placement.gd\").new(game, structure_config))


func _get_game() -> Game:
	var game_window := get_parent().get_parent()
	return game_window.get_node(^\"%Game\") as Game


func _show_control_window(anchor_mouse: Vector2i) -> void:
	if not _control_window:
		_control_window = get_tree().current_scene.get_node(^\"ControlWindow\") as Window
	if not _control_window_positioned:
		_place_control_window_near_mouse(anchor_mouse)
		_control_window_positioned = true
	_control_window.show()
	_control_window.mode = Window.MODE_WINDOWED
	_control_window.grab_focus()


func _place_control_window_near_mouse(mouse: Vector2i) -> void:
	var screen := DisplayServer.get_screen_from_rect(Rect2(mouse, Vector2.ONE))
	var usable := DisplayServer.screen_get_usable_rect(screen)
	var _size := _control_window.size
	var pos := mouse
	pos.x = clampi(pos.x, usable.position.x, usable.position.x + maxi(0, usable.size.x - _size.x))
	pos.y = clampi(pos.y, usable.position.y, usable.position.y + maxi(0, usable.size.y - _size.y))
	_control_window.current_screen = screen
	_control_window.position = pos
"

