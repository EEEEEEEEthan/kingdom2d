[sub_resource type="GDScript" id="GDScript_camera"]
script/source = "extends Camera2D

var _center_x: float
var _drag_loop_active := false


func _ready() -> void:
	_center_x = Game.MAP_WIDTH * 0.5
	position.x = _center_x
	position_smoothing_enabled = true


func reset_to_center() -> void:
	position.x = _center_x


func is_map_center_off_screen() -> bool:
	return not _view_rect().has_point(Vector2(_center_x, position.y))


func _unhandled_input(event: InputEvent) -> void:
	if not event is InputEventMouseButton:
		return
	var mouse_button := event as InputEventMouseButton
	if mouse_button.button_index != MOUSE_BUTTON_LEFT or not mouse_button.pressed:
		return
	if _drag_loop_active:
		return
	_drag_pan_loop()


func _drag_pan_loop() -> void:
	_drag_loop_active = true
	var anchor_mouse_x := get_viewport().get_mouse_position().x
	var anchor_camera_x: float = position.x
	while Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT):
		var delta_x := get_viewport().get_mouse_position().x - anchor_mouse_x
		position.x = round(_clamp_camera_x(anchor_camera_x - delta_x))
		await get_tree().physics_frame
	_drag_loop_active = false


func _view_rect() -> Rect2:
	var viewport := get_viewport()
	var viewport_size := viewport.get_visible_rect().size
	var to_world := viewport.get_canvas_transform().affine_inverse()
	var world_top_left := to_world * Vector2.ZERO
	var world_bottom_right := to_world * viewport_size
	var rect_origin := world_top_left.min(world_bottom_right)
	return Rect2(rect_origin, world_top_left.max(world_bottom_right) - rect_origin)


func _view_half_width() -> float:
	return _view_rect().size.x * 0.5


func _clamp_camera_x(x: float) -> float:
	var half_view := _view_half_width()
	return clampf(x, half_view, Game.MAP_WIDTH - half_view)
"

[sub_resource type="GDScript" id="GDScript_sky"]
script/source = "extends Sprite2D

const _KEY_DAY_FRACTIONS := [0.0, 0.23, 0.27, 0.5, 0.73, 0.77, 1.0]
const _KEY_SKY_TOP_COLORS := [
	Color(0.18, 0.22, 0.42),
	Color(0.32, 0.28, 0.48),
	Color(0.71, 0.81, 0.98),
	Color(0.45, 0.72, 1.0),
	Color(0.98, 0.55, 0.32),
	Color(0.28, 0.24, 0.46),
	Color(0.18, 0.22, 0.42),
]
const _SUNRISE_FRACTION := 0.25
const _SUNSET_FRACTION := 0.75
const _KEY_AMBIENT_COLORS := [
	Color(0.42, 0.48, 0.72),
	Color(0.5, 0.44, 0.62),
	Color(0.92, 0.78, 0.62),
	Color(1.0, 1.0, 1.0),
	Color(0.95, 0.72, 0.5),
	Color(0.48, 0.44, 0.66),
	Color(0.42, 0.48, 0.72),
]
const _KEY_SKY_BOTTOM_COLORS := [
	Color(0.28, 0.32, 0.55),
	Color(0.42, 0.36, 0.58),
	Color(0.71, 0.81, 0.98),
	Color(0.38, 0.55, 0.98),
	Color(0.38, 0.25, 0.55),
	Color(0.34, 0.3, 0.52),
	Color(0.28, 0.32, 0.55),
]

var _game: Game:
	get:
		return owner as Game

var _sky_gradient: Gradient


func _ready() -> void:
	_sky_gradient = (texture as GradientTexture2D).gradient
	_apply_sky()


func _process(_delta: float) -> void:
	_apply_sky()


func _apply_sky() -> void:
	var day_fraction := _game.game_time.day_fraction
	var sun_phase := (day_fraction - _SUNRISE_FRACTION) / (_SUNSET_FRACTION - _SUNRISE_FRACTION) * PI
	var sun_height := 0.0 if sun_phase <= 0.0 or sun_phase >= PI else sin(sun_phase)
	var night_tint := _sample_color_keyframes(_KEY_DAY_FRACTIONS, _KEY_AMBIENT_COLORS, day_fraction)
	%CanvasModulate.color = night_tint if sun_height <= 0.0 else night_tint.lerp(Color.WHITE, sun_height)
	var sky_top := _sample_color_keyframes(_KEY_DAY_FRACTIONS, _KEY_SKY_TOP_COLORS, day_fraction)
	var sky_bottom := _sample_color_keyframes(_KEY_DAY_FRACTIONS, _KEY_SKY_BOTTOM_COLORS, day_fraction)
	sky_bottom.a = 0.0
	_sky_gradient.set_color(0, sky_top)
	_sky_gradient.set_color(1, sky_bottom)


func _sample_color_keyframes(key_fractions: Array, key_colors: Array, day_fraction: float) -> Color:
	if day_fraction >= key_fractions[key_fractions.size() - 1]:
		return key_colors[key_colors.size() - 1]
	for index in key_fractions.size() - 1:
		var end_fraction: float = key_fractions[index + 1]
		if day_fraction < end_fraction:
			var start_fraction: float = key_fractions[index]
			var weight := (day_fraction - start_fraction) / (end_fraction - start_fraction)
			return key_colors[index].lerp(key_colors[index + 1], weight)
	return key_colors[0]
"

[sub_resource type="GDScript" id="GDScript_editor_time_debug"]
script/source = "extends Node

const ADVANCE_HOURS := 1.0

var _game: Game:
	get:
		return owner as Game

var _kp_add_down := false


func _ready() -> void:
	if not OS.has_feature(\"editor\"):
		return
	set_process(true)


func _process(_delta: float) -> void:
	var down := Input.is_physical_key_pressed(KEY_KP_ADD)
	if down and not _kp_add_down:
		_game.advance_debug_time_by_hours(ADVANCE_HOURS)
		var time: GameTime = _game.game_time
		print(
			\"debug: 推进1小时 hour=%s day_fraction=%.3f all_days=%.4f\"
			% [time.hour_of_day, time.day_fraction, time.all_days]
		)
	_kp_add_down = down
"

