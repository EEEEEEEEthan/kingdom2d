[gd_scene format=3 uid="uid://n3eb1xsiuq1d"]

[ext_resource type="Texture2D" uid="uid://d1uypro677rg0" path="res://theme.png" id="1_k4ubr"]

[sub_resource type="GDScript" id="GDScript_wa830"]
script/source = "extends Window

const MAX_GAME_WIDTH := 4096

signal game_visibility_toggled(is_visible: bool)
signal reset_game_requested
signal scale_changed(new_scale: int)
signal width_ratio_changed(width_ratio: float)

@export var game_window: Window

func _ready() -> void:
	_apply_width_slider_limit()
	_sync_from_game_window()

func _sync_from_game_window() -> void:
	%ScaleSlider.set_value_no_signal(float(game_window.scale))
	var width_ratio := minf(game_window.width_ratio, %WidthSlider.max_value)
	%WidthSlider.set_value_no_signal(width_ratio)
	%Button.set_pressed_no_signal(game_window.visible)

func _apply_width_slider_limit() -> void:
	var screen_width := DisplayServer.screen_get_size(current_screen).x
	var max_ratio := minf(1.0, float(MAX_GAME_WIDTH) / float(screen_width))
	%WidthSlider.max_value = max_ratio
	if %WidthSlider.value > max_ratio:
		%WidthSlider.value = max_ratio

func _on_scale_slider_value_changed(value: float) -> void:
	scale_changed.emit(int(value))

func _on_width_slider_value_changed(value: float) -> void:
	width_ratio_changed.emit(value)

func _on_reset_game_pressed() -> void:
	%ResetConfirmDialog.popup_centered()

func _on_reset_confirm_dialog_confirmed() -> void:
	reset_game_requested.emit()
"

