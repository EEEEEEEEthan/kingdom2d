[sub_resource type="GDScript" id="GDScript_miis5"]
script/source = "extends Node

func _on_control_window_game_visibility_toggled(toggled: bool) -> void:
	%Game.visible = toggled

func _on_control_window_scale_changed(new_scale: int) -> void:
	%Game.scale = new_scale

func _on_control_window_width_ratio_changed(width_ratio: float) -> void:
	%Game.width_ratio = width_ratio

func _on_control_window_reset_game_requested() -> void:
	var game := %Game.get_node(\"Game\") as Game
	game.reset_game()
"

