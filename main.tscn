"

[sub_resource type="GDScript" id="GDScript_game_window_slide"]
script/source = "extends Node

const SLIDE_SPEED_PIXELS_PER_SECOND := 2400.0

@export var _game_window: Window
var _desired_shown := true
var _target_global_position := Vector2i.ZERO


func _ready() -> void:
	_game_window = %Game
	set_process(false)


func _refresh_target_global_position() -> void:
	if _desired_shown:
		_target_global_position = _game_window.compute_docked_global_position()
	else:
		_target_global_position = _game_window.compute_hidden_below_global_position()


func set_game_shown(shown: bool) -> void:
	if _desired_shown == shown and not is_processing():
		return
	_desired_shown = shown
	_game_window.suppress_dock_position_in_layout = true
	_game_window.apply_layout(true)
	_refresh_target_global_position()
	if shown and _game_window.position.y >= _game_window.compute_hidden_below_global_position().y:
		_game_window.position = _game_window.compute_hidden_below_global_position()
	set_process(true)


func _on_game_window_size_changed() -> void:
	_refresh_target_global_position()


func _process(delta: float) -> void:
	var current_global_position := Vector2(_game_window.position)
	var target_global_position := Vector2(_target_global_position)
	var next_global_position := current_global_position.move_toward(
		target_global_position,
		SLIDE_SPEED_PIXELS_PER_SECOND * delta,
	)
	_game_window.position = Vector2i(next_global_position)
	if Vector2i(next_global_position) == _target_global_position:
		_finish_slide()


func _finish_slide() -> void:
	set_process(false)
	_game_window.suppress_dock_position_in_layout = not _desired_shown
"

[sub_resource type="GDScript" id="GDScript_quit_confirm"]
script/source = "extends ConfirmationDialog

func _ready() -> void:
	visible = false

func _notification(what: int) -> void:
	if what == NOTIFICATION_VISIBILITY_CHANGED and visible:
		_place_near_global_mouse()


func _place_near_global_mouse() -> void:
	var anchor_global := DisplayServer.mouse_get_position()
	var screen := DisplayServer.get_screen_from_rect(Rect2(anchor_global, Vector2.ONE))
	current_screen = screen
	reset_size()
	var window_size := size
	var usable := DisplayServer.screen_get_usable_rect(screen)
	var pos := anchor_global
	pos.x = clampi(pos.x, usable.position.x, usable.position.x + maxi(0, usable.size.x - window_size.x))
	pos.y = clampi(pos.y, usable.position.y, usable.position.y + maxi(0, usable.size.y - window_size.y))
	position = pos
"

