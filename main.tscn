[sub_resource type="GDScript" id="GDScript_display_scale_wheel"]
script/source = "extends Node

const MIN_DISPLAY_SCALE := 1
const MAX_DISPLAY_SCALE := 8
const HOOK_NODE_NAME := \"DisplayScaleWheelHook\"


func _ready() -> void:
	await get_tree().process_frame
	for child in owner.get_children():
		if child is Window:
			_attach_hook(child as Window)


func _attach_hook(window: Window) -> void:
	if window.get_node_or_null(HOOK_NODE_NAME):
		return
	var hook := WheelHook.new()
	hook.name = HOOK_NODE_NAME
	hook.controller = self
	window.add_child(hook)


func _try_apply_display_scale_wheel(event: InputEvent) -> void:
	if not event is InputEventMouseButton:
		return
	var mouse_button := event as InputEventMouseButton
	if not mouse_button.ctrl_pressed:
		return
	if mouse_button.button_index != MOUSE_BUTTON_WHEEL_UP and mouse_button.button_index != MOUSE_BUTTON_WHEEL_DOWN:
		return
	if not mouse_button.pressed:
		return
	var delta := 1 if mouse_button.button_index == MOUSE_BUTTON_WHEEL_UP else -1
	var new_scale := clampi(Settings.display_scale + delta, MIN_DISPLAY_SCALE, MAX_DISPLAY_SCALE)
	if new_scale == Settings.display_scale:
		return
	Settings.display_scale = new_scale
	get_viewport().set_input_as_handled()


class WheelHook extends Node:
	var controller: Node

	func _input(event: InputEvent) -> void:
		controller._try_apply_display_scale_wheel(event)
"

[sub_resource type="GDScript" id="GDScript_open_settings"]
script/source = "extends Node

var _panel: Control


func open() -> void:
	if not is_instance_valid(_panel):
		_panel = %SettingsPanelPlaceHolder.create_instance()
		_panel.reset_game_requested.connect(%GameWindow.reset_game)
		_panel.tree_exiting.connect(func() -> void: _panel = null)
	%Browser.add_page(\"设置\", _panel)
"

[sub_resource type="GDScript" id="GDScript_open_inspector"]
script/source = "extends Node

var _panels: Dictionary[Character, InspectorPanel] = {}


func open(character: Character) -> void:
	var panel: InspectorPanel = _panels.get(character)
	if not is_instance_valid(panel):
		panel = %InspectorPanelPlaceHolder.create_instance() as InspectorPanel
		_panels[character] = panel
		panel.tree_exiting.connect(func() -> void: _panels.erase(character))
		character.tree_exiting.connect(_on_character_exiting.bind(character, panel), CONNECT_ONE_SHOT)
	%Browser.add_page(\"角色 %s\" % character.id, panel)
	await panel.inspect_character(character)


func _on_character_exiting(character: Character, panel: InspectorPanel) -> void:
	_panels.erase(character)
	if not is_instance_valid(panel):
		return
	var slot := panel.get_parent()
	if slot:
		var page := slot.get_parent()
		if page and page.get_parent() != owner:
			page.queue_free()
			return
	panel.queue_free()
"

[sub_resource type="GDScript" id="GDScript_quit_confirm"]
script/source = "extends ConfirmationDialog

func _ready() -> void:
	visible = false

func _on_confirmed() -> void:
	owner.get_tree().quit()

func _notification(what: int) -> void:
	if what == NOTIFICATION_VISIBILITY_CHANGED and visible:
		_place_near_global_mouse()


func _place_near_global_mouse() -> void:
	var anchor_global := DisplayServer.mouse_get_position()
	var screen := DisplayServer.get_screen_from_rect(Rect2(anchor_global, Vector2.ONE))
	current_screen = screen
	reset_size()
	var window_size := size
	var usable := DisplayServer.screen_get_usable_rect(screen)
	var pos := anchor_global
	pos.x = clampi(pos.x, usable.position.x, usable.position.x + maxi(0, usable.size.x - window_size.x))
	pos.y = clampi(pos.y, usable.position.y, usable.position.y + maxi(0, usable.size.y - window_size.y))
	position = pos
"

