[sub_resource type="GDScript" id="GDScript_miis5"]
script/source = "extends Node

func request_quit() -> void:
	%QuitConfirmDialog.visible = true

func _on_quit_confirm_dialog_confirmed() -> void:
	get_tree().quit()
"

[sub_resource type="GDScript" id="GDScript_quit_confirm"]
script/source = "extends ConfirmationDialog

func _ready() -> void:
	visible = false

func _notification(what: int) -> void:
	if what == NOTIFICATION_VISIBILITY_CHANGED and visible:
		_place_near_global_mouse()


func _place_near_global_mouse() -> void:
	var anchor_global := DisplayServer.mouse_get_position()
	var screen := DisplayServer.get_screen_from_rect(Rect2(anchor_global, Vector2.ONE))
	current_screen = screen
	reset_size()
	var window_size := size
	var usable := DisplayServer.screen_get_usable_rect(screen)
	var pos := anchor_global
	pos.x = clampi(pos.x, usable.position.x, usable.position.x + maxi(0, usable.size.x - window_size.x))
	pos.y = clampi(pos.y, usable.position.y, usable.position.y + maxi(0, usable.size.y - window_size.y))
	position = pos
"

