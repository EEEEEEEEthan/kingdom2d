[sub_resource type="GDScript" id="GDScript_miis5"]
script/source = "extends Node

func _ready() -> void:
	%Game.scale = %SettingPanel.get_scale()
	%Game.width_ratio = %SettingPanel.get_width_ratio()
	%Game.apply_layout()

func _on_setting_panel_game_visibility_toggled(toggled: bool) -> void:
	%Game.visible = toggled

func _on_setting_panel_scale_changed(scale: int) -> void:
	%Game.scale = scale

func _on_setting_panel_width_ratio_changed(width_ratio: float) -> void:
	%Game.width_ratio = width_ratio
"

