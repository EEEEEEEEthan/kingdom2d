[sub_resource type="GDScript" id="GDScript_14jt7"]
script/source = "extends StatusIndicator

signal control_window_open_requested

enum MenuId { SHOW_CONTROL_WINDOW, QUIT }

var _tray_supported := (
	DisplayServer.has_feature(DisplayServer.FEATURE_STATUS_INDICATOR)
	and not Engine.is_embedded_in_editor()
)

const ENGINE_ROOT_OFFSCREEN_POS := Vector2i(-32000, -32000)
const ENGINE_ROOT_SIZE := Vector2i(1, 1)

var _control_window: Window

@onready var _menu: PopupMenu = $PopupMenu


func _ready() -> void:
	visible = false
	if not _tray_supported:
		return

	get_tree().auto_accept_quit = false

	await get_tree().process_frame
	_control_window = get_tree().current_scene.get_node(^\"ControlWindow\") as Window
	_control_window.close_requested.connect(_on_control_window_close_requested)

	_pin_engine_root_offscreen()
	await get_tree().process_frame
	_pin_engine_root_offscreen()
	get_window().close_requested.connect(_on_engine_root_close_requested)
	_hide_to_tray()


func _notification(what: int) -> void:
	if not _tray_supported:
		return
	if what == NOTIFICATION_WM_CLOSE_REQUEST:
		_hide_to_tray()


func _pin_engine_root_offscreen() -> void:
	var root := get_window()
	root.unfocusable = true
	root.min_size = ENGINE_ROOT_SIZE
	root.max_size = ENGINE_ROOT_SIZE
	root.size = ENGINE_ROOT_SIZE
	root.position = ENGINE_ROOT_OFFSCREEN_POS


func _on_engine_root_close_requested() -> void:
	_hide_to_tray()


func _on_control_window_close_requested() -> void:
	_hide_to_tray()


func _hide_to_tray() -> void:
	_control_window.hide()
	_pin_engine_root_offscreen()
	visible = true


func _on_pressed(mouse_button: int, _mouse_position: Vector2i) -> void:
	match mouse_button:
		MOUSE_BUTTON_LEFT:
			control_window_open_requested.emit()
		MOUSE_BUTTON_RIGHT:
			var global_mouse := DisplayServer.mouse_get_position()
			var screen := DisplayServer.get_screen_from_rect(Rect2(global_mouse, Vector2.ONE))
			var screen_mouse := global_mouse - DisplayServer.screen_get_position(screen)
			_menu.current_screen = screen
			_menu.popup(Rect2i(screen_mouse, Vector2i.ZERO))


func _on_popup_menu_id_pressed(id: int) -> void:
	match id as MenuId:
		MenuId.SHOW_CONTROL_WINDOW:
			control_window_open_requested.emit()
		MenuId.QUIT:
			get_tree().current_scene.request_quit()
"

[sub_resource type="GDScript" id="GDScript_k6dh4"]
script/source = "extends PopupMenu

func _ready() -> void:
	visible = false
"

