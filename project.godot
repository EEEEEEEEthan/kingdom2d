; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kingdom2D"
run/main_scene="uid://dkui3dlb4vu1c"
config/features=PackedStringArray("4.7")

[autoload]

Tray="*res://tray/tray.tscn"

[display]

window/size/viewport_width=1
window/size/viewport_height=1
window/energy_saving/keep_screen_on=false
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_editable_texture/plugin.cfg")

[gui]

theme/custom="uid://dlq4pbrcr35rn"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
textures/default_filters/anisotropic_filtering_level=0
